NODE_ENV=development

# Backend API
PORT=3000

# MongoDB (cluster edj-labs partagé — 500 connexions max au total entre toutes les apps)
MONGODB_URI=mongodb://localhost:27017/fluentquest
MONGO_MAX_POOL=10

# Auth secrets (générer avec : openssl rand -hex 32)
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# Field-level encryption (AES-256-GCM) — pour transcripts segment.text
# Générer avec : openssl rand -hex 32  (DOIT faire exactement 64 hex chars = 32 bytes)
FIELD_ENCRYPTION_KEY=change-me-64-hex-chars

# edj-labs LLM proxy (OpenAI-compatible)
EDJ_API_KEY=
EDJ_API_BASE=https://api.perplexity.edj-labs.com/v1
EDJ_DEFAULT_MODEL=pplx-claude-sonnet-4.6

# CORS (comma-separated origins autorisés par l'API)
CORS_ORIGINS=http://localhost:5173,app://fluentquest-desktop

# Frontend (Vite — VITE_ prefix obligatoire pour bundling)
VITE_API_URL=http://localhost:3000
