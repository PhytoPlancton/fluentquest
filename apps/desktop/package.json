{
  "name": "@fluentquest/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.renderer.config.ts",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "dev": "tsc -p tsconfig.json && vite build --config vite.renderer.config.ts && electron .",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "clean": "rimraf dist release .turbo"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.0",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.fluentquest.desktop",
    "productName": "FluentQuest",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-node/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FluentQuest needs your microphone to capture your voice during sessions.",
        "NSScreenCaptureUsageDescription": "FluentQuest needs to capture system audio (your VoIP call) so it can transcribe both speakers.",
        "NSCameraUsageDescription": "Not used. Only audio is captured."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "PhytoPlancton",
      "repo": "fluentquest"
    }
  }
}
