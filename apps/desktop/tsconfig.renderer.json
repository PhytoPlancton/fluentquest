{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/renderer",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["renderer/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
